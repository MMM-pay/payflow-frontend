{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "/",
        "/account/",
        "/m/",
        "/mandates/",
        "/merchant/",
        "/plans/1/",
        "/receipt/",
        "/status/",
        "/subscribe/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.60 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      },
      "assertMatrix": [
        {
          "matchingUrlPattern": "https?://[^/]+/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/account/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/m/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 3300 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/mandates/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/merchant/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/plans/1/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 4800 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/receipt/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/status/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "https?://[^/]+/subscribe/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 3600 }]
          }
        }
      ]
    }
  }
}
