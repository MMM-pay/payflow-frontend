{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "/",
        "/account/",
        "/m/",
        "/mandates/",
        "/merchant/",
        "/plans/1/",
        "/receipt/",
        "/subscribe/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
          "categories:performance": ["error", { "minScore": 0.65 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
