# Soroban RPC the browser talks to directly for contract writes
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Deployed contracts (payflow-contract/scripts/deploy.sh prints these)
NEXT_PUBLIC_PLAN_REGISTRY_ID=CDQ5EJTVXXX2CBMHWP3BGGUDHSK6D4I25IF5XXH3QGL2TNTBMJUOFKDB
NEXT_PUBLIC_VAULT_ID=CBNQEWSYYQOKNX5KB62OFT6ID5TCVSWN4PS4AXAJK6IWUEXOLVN6DXII
NEXT_PUBLIC_SUBSCRIPTION_ID=CD5YZUJU6WLFIHGAV4J2BV42GCVZE5ZGDUGSW5CBRIA47TQHSZZW3XMM
NEXT_PUBLIC_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Account used only as the source for read-only contract simulation before a
# wallet connects. Must exist on the network; it is never charged.
NEXT_PUBLIC_READ_SOURCE=GAKOHW5FUKSF3SXQQWLD647RQJPOR5RZOS4ITSMWC5NPC67DEXXYU43H

# payflow-backend base URL. Must be set at BUILD time, not just runtime:
# NEXT_PUBLIC_* values are inlined during the build.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Mainnet (optional) ---
# One build can serve several networks: the header offers a network switcher
# once a network below has its RPC URL and its contract ids (plan registry,
# vault, subscription, token) set. Leave these commented out (the default)
# and the app serves testnet only.
# Each network keeps its own backend: an empty NEXT_PUBLIC_MAINNET_API_URL
# runs mainnet in contract-only mode.
# NEXT_PUBLIC_MAINNET_SOROBAN_RPC_URL=
# NEXT_PUBLIC_MAINNET_HORIZON_URL=https://horizon.stellar.org
# NEXT_PUBLIC_MAINNET_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# NEXT_PUBLIC_MAINNET_PLAN_REGISTRY_ID=
# NEXT_PUBLIC_MAINNET_VAULT_ID=
# NEXT_PUBLIC_MAINNET_SUBSCRIPTION_ID=
# NEXT_PUBLIC_MAINNET_TOKEN_ID=
# NEXT_PUBLIC_MAINNET_USDC_TOKEN_ID=
# NEXT_PUBLIC_MAINNET_READ_SOURCE=
# NEXT_PUBLIC_MAINNET_API_URL=

# Optional public WalletConnect/Reown project ID (not a secret). Register the
# deployed origin in the project allowlist; rebuild after setting this value.
# Empty leaves all default wallets available and omits WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
